NODE_ENV=development
ALLOW_SYNTHETIC_SEED=true
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000
API_DOCUMENTATION_ENABLED=true
HTTP_RATE_LIMIT_MAX=100
HTTP_RATE_LIMIT_WINDOW=1 minute

PUBLIC_QUERY_API_PORT=3001
PUBLIC_QUERY_API_HOST=0.0.0.0
PUBLIC_API_BASE_URL=http://localhost:3001
COMMAND_API_PORT=3002

POSTGRES_DATABASE=medicos_catalog
POSTGRES_SUPERUSER_USERNAME=medicos
POSTGRES_SUPERUSER_PASSWORD=change-me-local-admin
POSTGRES_PUBLIC_QUERY_PASSWORD=change-me-local-reader
POSTGRES_PRIVATE_INGESTOR_PASSWORD=change-me-local-private-writer

CATALOG_DATABASE_URL=postgresql://medicos_public_query:change-me-local-reader@localhost:5432/medicos_catalog
CATALOG_MIGRATION_DATABASE_URL=postgresql://medicos:change-me-local-admin@localhost:5432/medicos_catalog
CATALOG_SEED_DATABASE_URL=postgresql://medicos:change-me-local-admin@localhost:5432/medicos_catalog
CATALOG_DATABASE_POOL_MAX=10
CATALOG_DATABASE_SSL=false
