# Copy this file to .env.data.local. The local file is ignored by Git.
# Generate a different high-entropy value for every environment.
MSP_LINKAGE_HMAC_KEY=

# TLS verification stays enabled by default. This escape hatch is only for a
# diagnosed local certificate-chain problem and must remain false in production.
MSP_ALLOW_INSECURE_TLS=false

MSP_INGESTION_DATA_DIR=data
MSP_INFOTITULOS_URL=https://www.gub.uy/ministerio-salud-publica/sites/ministerio-salud-publica/files/2026-07/Infot%C3%ADtulos%20-%20Junio%202026.csv

# Shared root for linkage and directory snapshots. To pin provider inputs instead of selecting
# their latest complete manifests, list absolute or workspace-relative NDJSON paths separated by
# the operating system path delimiter (semicolon on Windows).
DATA_INGESTION_DIR=data
LINKAGE_PROVIDER_INPUT_PATHS=
DIRECTORY_MSP_INPUT_PATH=
DIRECTORY_LINKAGE_INPUT_PATH=
DIRECTORY_OUTPUT_DIR=

# Name-only news discovery. NEWS_ARTICLES_PATH is mandatory and must point to the normalized
# schema documented in scripts/ingestion/news/README.md. The pipeline never scrapes, links,
# confirms facts, or publishes. NEWS_PROFESSIONALS_PATH may point to normalized MSP
# professionals.ndjson or an internal factual-v3 profiles.ndjson; blank selects the latest MSP
# snapshot. Every path and output must stay below DATA_INGESTION_DIR.
NEWS_PROFESSIONALS_PATH=
# Optional destination for the atomic official RSS/sitemap collector artifact.
# Blank selects data/normalized/news/news-index-v1-<fingerprint> (schema v1).
NEWS_INDEX_OUTPUT_DIR=
NEWS_ARTICLES_PATH=
# Blank selects manifest.json beside NEWS_ARTICLES_PATH. The matcher verifies its hash, record
# count and expiration before reading the batch.
NEWS_ARTICLES_MANIFEST_PATH=
NEWS_CANDIDATES_OUTPUT_DIR=
# El País and Subrayado are disabled by default. Set a source to true only after obtaining current
# written authorization. The reference is never persisted; only its SHA-256 is recorded. The
# comma-separated allowlist must be provisioned independently by the legal/data controller and
# contain that exact SHA-256; arbitrary references do not enable a source.
NEWS_ENABLE_ELPAIS=false
NEWS_ELPAIS_AUTHORIZATION_REFERENCE=
NEWS_ELPAIS_AUTHORIZATION_SHA256_ALLOWLIST=
NEWS_ENABLE_SUBRAYADO=false
NEWS_SUBRAYADO_AUTHORIZATION_REFERENCE=
NEWS_SUBRAYADO_AUTHORIZATION_SHA256_ALLOWLIST=

# Source-first web enrichment. Disabled by default and always written to an internal quarantine;
# it never feeds the public directory. The policy file must explicitly approve every HTTPS host
# and seed URL. Crawl4AI receives public allowlisted URLs only: never secrets, cookies or nominal
# search queries. DuckDuckGo is an optional low-volume discovery fallback and stops on CAPTCHA,
# HTTP 202/403/429 instead of attempting to bypass it.
DAILY_REFRESH_WEB_ENRICHMENT_ENABLED=false
WEB_ENRICHMENT_SOURCE_POLICY_PATH=
WEB_ENRICHMENT_PROFESSIONALS_PATH=
WEB_ENRICHMENT_OUTPUT_DIR=
WEB_ENRICHMENT_MAX_SOURCE_PAGES_PER_RUN=25
WEB_ENRICHMENT_CRAWL4AI_ENABLED=true
WEB_ENRICHMENT_CRAWL4AI_BASE_URL=https://crawl4ai.checkleaked.cc
WEB_ENRICHMENT_CRAWL_TIMEOUT_MS=45000
WEB_ENRICHMENT_MAX_RESPONSE_BYTES=10485760
WEB_ENRICHMENT_DUCKDUCKGO_ENABLED=false
WEB_ENRICHMENT_DUCKDUCKGO_MAX_QUERIES_PER_RUN=20

# On-demand private research view. Blank MSP/linkage paths select the latest compatible manifests.
# The reference ledger contains URLs and researcher-written factual metadata only; raw page bodies,
# snippets and LinkedIn profile data are rejected. Every path must stay below DATA_INGESTION_DIR.
PROFESSIONAL_RESEARCH_MSP_PATH=
PROFESSIONAL_RESEARCH_LINKAGE_PATH=
PROFESSIONAL_RESEARCH_REFERENCES_PATH=
PROFESSIONAL_RESEARCH_OUTPUT_DIR=

# Public notice/controller metadata. Keep values blank until they are real and documented:
# bracketed/example placeholders are rejected, the rights contact must be a valid email and the
# privacy notice must be an absolute HTTPS URL. Configuring every field still leaves approval at
# required=true, approved=false and does not remove the legal/privacy publication gate.
DIRECTORY_DATA_CONTROLLER_NAME=
DIRECTORY_DATA_CONTROLLER_ADDRESS=
DIRECTORY_DATABASE_NAME=
DIRECTORY_DATA_RIGHTS_EMAIL=
DIRECTORY_PRIVACY_NOTICE_URL=
DIRECTORY_URCDP_REGISTRATION=
# Processors act on the controller's instructions; recipients are the independent people or
# categories to whom data is disclosed. They must be declared separately, including "none".
DIRECTORY_PROCESSORS_NOTICE=
DIRECTORY_RECIPIENTS_NOTICE=
DIRECTORY_INTERNATIONAL_TRANSFERS_NOTICE=

# Public export remains fail-closed. Copy the example policy, replace every placeholder with
# reviewed evidence and approvals, sign its exact bytes with the authorized Ed25519 key, and
# keep the signing private key and high-entropy profile-id secret outside Git. The trusted
# fingerprint is SHA-256 over the DER/SPKI public key, not over either secret.
PUBLICATION_POLICY_PATH=
PUBLICATION_POLICY_SIGNATURE_PATH=
PUBLICATION_POLICY_PUBLIC_KEY_PATH=
PUBLICATION_POLICY_SIGNER_KEY_ID=
PUBLICATION_POLICY_SIGNER_FINGERPRINT_SHA256=
# Separate high-entropy HMAC key authenticating the generated manifest for the delivery reader.
# Use canonical padded base64 or unpadded base64url encoding of at least 32 random bytes.
# Rotate the key id whenever this secret changes; never reuse PUBLIC_PROFILE_ID_SECRET.
# Deploy key, key id, artifact and its selector as one version; the reader accepts one pair at a time.
PUBLIC_DIRECTORY_ARTIFACT_AUTH_KEY=
PUBLIC_DIRECTORY_ARTIFACT_AUTH_KEY_ID=
# Independent canonical base64/base64url encoding of at least 32 random bytes.
PUBLIC_PROFILE_ID_SECRET=
PUBLIC_DIRECTORY_INPUT_DIR=
PUBLIC_DIRECTORY_OUTPUT_DIR=
