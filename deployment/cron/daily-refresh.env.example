# Install as /etc/medicos-backend/daily-refresh.env, owned by root:medicos with mode 0640.
MEDICOS_APP_DIRECTORY=/opt/medicos-backend
MEDICOS_PNPM_EXECUTABLE=/usr/bin/pnpm
MEDICOS_REFRESH_LOCK_FILE=/var/lib/medicos-backend/daily-refresh.lock

DATA_INGESTION_DIR=/var/lib/medicos-backend/data
MSP_INGESTION_DATA_DIR=/var/lib/medicos-backend/data
INGESTION_DATA_DIR=/var/lib/medicos-backend/data

# Required high-entropy secret. Never commit a real value.
MSP_LINKAGE_HMAC_KEY=
MSP_ALLOW_INSECURE_TLS=false

# Comma-separated allowlist. Blank means every implemented mutualista adapter.
DAILY_REFRESH_MUTUALISTAS=casmu,asociacion-espanola,smi,medica-uruguaya,hospital-britanico
DAILY_REFRESH_NEWS_ENABLED=true

# Fail-closed default. Enabling this still requires every signed publication-policy variable from
# .env.data.example; otherwise the stage exits non-zero and nothing is published.
DAILY_REFRESH_PUBLIC_EXPORT_ENABLED=false

PUBLIC_SOURCE_TIMEOUT_MS=60000
CRAWL4AI_BASE_URL=https://crawl4ai.checkleaked.cc
