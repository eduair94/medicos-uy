# Install as /etc/medicos-backend/public-query-api.env with root:root 0600.
# Replace the public base URL and CORS origin after assigning the Cloudflare hostname.

MEDICOS_APP_DIRECTORY=/srv/medicos-backend/current
NODE_ENV=production
LOG_LEVEL=info
TZ=UTC

PUBLIC_QUERY_API_HOST=127.0.0.1
PUBLIC_QUERY_API_PORT=3001
PUBLIC_API_BASE_URL=https://api.example.com
CORS_ORIGINS=https://frontend.example.com
API_DOCUMENTATION_ENABLED=true
HTTP_RATE_LIMIT_MAX=100
HTTP_RATE_LIMIT_WINDOW=1 minute

CATALOG_DATABASE_URL=postgresql://medicos_public_query:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:6432/medicos_catalog
CATALOG_DATABASE_POOL_MAX=10
CATALOG_DATABASE_SSL=false
