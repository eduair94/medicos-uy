# Install as /etc/medicos-backend/private-analysis.env.
# Required ownership/mode: root:root 0600. The scheduler sources this file, so it rejects a
# symlink, a non-root owner, or any group/world permission.

MEDICOS_APP_DIRECTORY=/srv/medicos-backend/current
MEDICOS_NODE_EXECUTABLE=/absolute/path/to/supported-node-22-or-24
MEDICOS_TSX_EXECUTABLE=/srv/medicos-backend/current/node_modules/.bin/tsx
MEDICOS_FLOCK_EXECUTABLE=/usr/bin/flock
MEDICOS_ANALYSIS_LOCK_FILE=/var/lib/medicos-backend/private-analysis.lock
MEDICOS_ANALYSIS_STATUS_FILE=/var/lib/medicos-backend/logs/private-analysis/latest.json

# Keep Node below PM2's 1536 MiB process ceiling while building the complete MSP batch.
NODE_OPTIONS=--max-old-space-size=1024
NODE_ENV=production
TZ=UTC

DATA_INGESTION_DIR=/srv/medicos-backend/data

# Private PostgreSQL writer only. URL-encode special characters in the password.
# Keep TLS verification enabled when PostgreSQL is reached over TCP.
PROFESSIONAL_ANALYSIS_DATABASE_URL=postgresql://medicos_private_ingestor:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:6432/medicos_catalog
PROFESSIONAL_ANALYSIS_DATABASE_SSL_CA_PATH=/srv/medicos-postgres/tls/ca.crt
PROFESSIONAL_ANALYSIS_DATABASE_SSL_SERVERNAME=server.digitalshopuy.com

# The official MSP projection reuses the same TLS connection and runs only after analysis succeeds.
# Identify the operator/change record that explicitly authorized this release boundary.
MSP_CATALOG_PROJECTION_APPROVAL=PROJECT_OFFICIAL_MSP_FIELDS
MSP_CATALOG_PROJECTION_REVIEWED_BY=REPLACE_WITH_OPERATOR_OR_CHANGE_REFERENCE
MSP_CATALOG_PROJECTION_REVIEWED_AT=REPLACE_WITH_UTC_ISO_8601_APPROVAL_TIMESTAMP
MSP_CATALOG_PROJECTION_REVIEW_REFERENCE=https://www.gub.uy/ministerio-salud-publica/datos-y-estadisticas/microdatos/infotitulos-base-datos

# Explicit write approval and snapshot pin. The batch rejects any other approval and refuses to
# mix an MSP input with a different private-directory snapshot.
PROFESSIONAL_ANALYSIS_APPROVAL=STORE_PRIVATE_RESEARCH_DOSSIERS
PROFESSIONAL_ANALYSIS_EXPECTED_SNAPSHOT_ID=factual-v3-REPLACE_WITH_16_HEX
PROFESSIONAL_ANALYSIS_BATCH_SIZE=100
PROFESSIONAL_ANALYSIS_MAX_ATTEMPTS=3
PROFESSIONAL_ANALYSIS_LEASE_MINUTES=15
# 0 processes the complete pending queue. A positive value is only for controlled canaries.
PROFESSIONAL_ANALYSIS_MAX_ITEMS_PER_INVOCATION=0

# Blank selectors mean "latest complete compatible manifest" below DATA_INGESTION_DIR.
# Pin absolute paths during a controlled replay.
PROFESSIONAL_RESEARCH_MSP_PATH=
PROFESSIONAL_RESEARCH_LINKAGE_PATH=
PROFESSIONAL_RESEARCH_REFERENCES_PATH=

# The Colegio Médico ethics index expressly disallows automated crawling. This scheduler refuses
# to start if the value is changed. Curated links may be stored by the batch as unverified
# references, but this process never fetches the index, detail pages, or PDFs.
CMU_ETHICS_FETCH_ENABLED=false
