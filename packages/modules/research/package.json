{
  "name": "@medicos/research",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./nest": {
      "types": "./src/nest.ts",
      "require": "./dist/nest.js",
      "default": "./dist/nest.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@medicos/http": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/swagger": "catalog:",
    "pg": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  }
}
