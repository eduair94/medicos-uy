  "views": {
    "provenance.public_evidence_ref": {
      "columns": {
        "evidence_id": {
          "name": "evidence_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": true
        },
        "source_name": {
          "name": "source_name",
          "type": "varchar(200)",
          "primaryKey": false,
          "notNull": true
        },
        "source_canonical_url": {
          "name": "source_canonical_url",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        },
        "canonical_url": {
          "name": "canonical_url",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        },
        "observed_at": {
          "name": "observed_at",
          "type": "timestamp with time zone",
          "primaryKey": false,
          "notNull": true
        },
        "source_cutoff_date": {
          "name": "source_cutoff_date",
          "type": "date",
          "primaryKey": false,
          "notNull": true
        },
        "attribution": {
          "name": "attribution",
          "type": "varchar(500)",
          "primaryKey": false,
          "notNull": true
        }
      },
      "definition": "\n    select\n      \"provenance\".\"evidence_ref\".\"id\" as evidence_id,\n      \"provenance\".\"source\".\"name\" as source_name,\n      \"provenance\".\"source\".\"canonical_url\" as source_canonical_url,\n      \"provenance\".\"evidence_ref\".\"canonical_url\" as canonical_url,\n      \"provenance\".\"evidence_ref\".\"observed_at\" as observed_at,\n      \"provenance\".\"source_release\".\"cutoff_date\" as source_cutoff_date,\n      \"provenance\".\"evidence_ref\".\"attribution\" as attribution\n    from \"provenance\".\"evidence_ref\"\n    inner join \"provenance\".\"source_release\"\n      on \"provenance\".\"source_release\".\"id\" = \"provenance\".\"evidence_ref\".\"source_release_id\"\n    inner join \"provenance\".\"source\"\n      on \"provenance\".\"source\".\"id\" = \"provenance\".\"source_release\".\"source_id\"\n    where \"provenance\".\"evidence_ref\".\"publication_state\" = 'APPROVED'\n  ",
      "name": "public_evidence_ref",
      "schema": "provenance",
      "isExisting": false,
      "with": {
        "securityBarrier": true
      },
      "materialized": false
    },
    "catalog.public_professional_route": {
      "columns": {
        "slug": {
          "name": "slug",
          "type": "varchar(180)",
