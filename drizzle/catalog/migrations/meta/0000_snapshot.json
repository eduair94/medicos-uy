          "type": "professional_route_kind",
          "typeSchema": "catalog",
          "primaryKey": false,
          "notNull": true
        }
      },
      "definition": "\n    select\n      \"catalog\".\"professional_route\".\"slug\" as slug,\n      \"catalog\".\"professional_route\".\"professional_id\" as professional_id,\n      \"catalog\".\"professional_route\".\"route_kind\" as route_kind\n    from \"catalog\".\"professional_route\"\n    inner join \"catalog\".\"public_professional\"\n      on \"public_professional\".\"id\" = \"catalog\".\"professional_route\".\"professional_id\"\n  ",
      "name": "public_professional_route",
      "schema": "catalog",
      "isExisting": false,
      "with": {
        "securityBarrier": true
      },
      "materialized": false
    },
    "catalog.public_professional": {
      "columns": {
        "id": {
          "name": "id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": true
        },
        "display_name": {
          "name": "display_name",
          "type": "varchar(200)",
          "primaryKey": false,
          "notNull": true
        },
        "normalized_name": {
          "name": "normalized_name",
          "type": "varchar(200)",
          "primaryKey": false,
          "notNull": true
        },
        "current_name_evidence_id": {
          "name": "current_name_evidence_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": true
        }
      },
      "definition": "\n    select\n      \"catalog\".\"professional\".\"id\" as id,\n      \"catalog\".\"professional\".\"display_name\" as display_name,\n      \"catalog\".\"professional\".\"normalized_name\" as normalized_name,\n      \"catalog\".\"professional\".\"current_name_evidence_id\" as current_name_evidence_id\n    from \"catalog\".\"professional\"\n    where \"catalog\".\"professional\".\"visibility\" = 'PUBLIC'\n      and exists (\n        select 1\n        from provenance.public_evidence_ref as evidence\n        where evidence.evidence_id = \"catalog\".\"professional\".\"current_name_evidence_id\"\n      )\n  ",
      "name": "public_professional",
      "schema": "catalog",
      "isExisting": false,
      "with": {
        "securityBarrier": true
      },
      "materialized": false
    }
